DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_NAME=Digital PTT
DJANGO_TIME_ZONE=UTC

# Database: keep sqlite locally, switch to postgresql in production.
DB_ENGINE=sqlite
SQLITE_NAME=commerce.sqlite3
POSTGRES_DB=digital_ptt
POSTGRES_USER=digital_ptt
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_REFRESH_COOKIE_NAME=digital_ptt_refresh
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Strict
AUTH_REFRESH_COOKIE_DOMAIN=
API_PAGE_SIZE=20
LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
CACHE_TTL_SECONDS=300
THROTTLE_AUTH=10/min
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_CONTACT=5/hour
THROTTLE_QUOTE=10/hour
THROTTLE_IMAGE_UPLOAD=30/hour
THROTTLE_CHECKOUT=20/hour
THROTTLE_PAYMENT_TEST=30/hour

# Payments stay hidden from customers until a live provider and webhook flow are ready.
PAYMENTS_STOREFRONT_ENABLED=False
PAYMENTS_DEVELOPMENT_SIMULATOR=False
PAYMENT_SESSION_TTL_MINUTES=30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
PAYMENT_BANK_TRANSFER_INSTRUCTIONS=
SECURE_HSTS_SECONDS=31536000
# Local development prints messages in the Django terminal. Replace these with
# approved SMTP or Microsoft Graph settings in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@digitalptt.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
QUOTE_NOTIFICATION_EMAIL=sales@digitalptt.local

# Microsoft Graph email. Create a fresh secret and grant Mail.Send application
# permission with admin consent before enabling this in production.
MICROSOFT_GRAPH_EMAIL_ENABLED=False
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_EMAIL=salesteam@rack-n-brackets.com
MICROSOFT_GRAPH_TIMEOUT=30

# Optional Power Automate HTTP-trigger flow. Treat the webhook URL as a secret.
POWER_AUTOMATE_ENABLED=False
POWER_AUTOMATE_WEBHOOK_URL=
POWER_AUTOMATE_TIMEOUT=10
POWER_AUTOMATE_SHARED_SECRET=

# Keep False for immediate console email locally. Enable in production and run:
# python manage.py process_notifications
NOTIFICATIONS_ASYNC=False
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=60

FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=3600
