# Copy to backend/.env on the server. Replace every change-me value.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-generate-with-openssl-rand-base64-64
JWT_SIGNING_KEY=change-me-use-a-different-openssl-rand-base64-64-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
SITE_NAME=Digital PTT
DJANGO_TIME_ZONE=UTC

DB_ENGINE=postgresql
POSTGRES_DB=digital_ptt
POSTGRES_USER=digital_ptt
POSTGRES_PASSWORD=change-me-use-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=

CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
AUTH_REFRESH_COOKIE_NAME=digital_ptt_refresh
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=Strict
AUTH_REFRESH_COOKIE_DOMAIN=
FRONTEND_URL=https://example.com

API_DOCS_ENABLED=False
DJANGO_ADMIN_ENABLED=False
LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
WEB_CONCURRENCY=2

PAYMENTS_STOREFRONT_ENABLED=False
PAYMENTS_DEVELOPMENT_SIMULATOR=False
PAYMENT_SESSION_TTL_MINUTES=30
PAYMENT_PROVIDER_CALLBACK_MAX_BODY_BYTES=65536
PAYMENT_PROVIDER_RECONCILIATION_BATCH_SIZE=100

# Keep the console backend until Graph is configured. Production validation
# intentionally fails while Graph is disabled and this backend remains active.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=sales@example.com
QUOTE_NOTIFICATION_EMAIL=sales@example.com
MICROSOFT_GRAPH_EMAIL_ENABLED=False
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_EMAIL=sales@example.com
MICROSOFT_GRAPH_TIMEOUT=30

NOTIFICATIONS_ASYNC=True
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=60
LICENSE_RECONCILIATION_MAX_AGE_HOURS=26
NOTIFICATION_WORKER_MAX_AGE_MINUTES=10

PRIVATE_MEDIA_ROOT=/var/lib/digitalptt/private_media
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=25000000
SECURE_HSTS_SECONDS=31536000
