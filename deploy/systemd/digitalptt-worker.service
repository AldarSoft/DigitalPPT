[Unit]
Description=Digital PTT notification worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/srv/digitalptt/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/digitalptt/.venv/bin/python /srv/digitalptt/backend/deploy_start.py worker
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
