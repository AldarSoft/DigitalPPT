[Unit]
Description=Check Digital PTT background operation health
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=www-data
WorkingDirectory=/srv/digitalptt/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/digitalptt/.venv/bin/python manage.py check_operations
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
